<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coffeequeque.Controller.HistorialController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #000000;" text="Historial de Acciones" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: #7f8c8d;" text="Últimas acciones registradas en el sistema (La más reciente se encuentra en la cima):" />

                <ListView fx:id="listViewHistorial" prefHeight="330.0" prefWidth="610.0" style="-fx-background-radius: 6; -fx-border-radius: 6;" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="btnDeshacer" mnemonicParsing="false" style="-fx-background-color: #871d12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20;" text="↩ Deshacer Última Acción (Pop)" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
