<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="560.0" prefWidth="350.0" spacing="12.0" style="-fx-padding: 30; -fx-background-color: #fffdf9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coffeequeque.Controller.RegistroController">
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e5a11;" text="Crear Cuenta" />

        <VBox spacing="5.0">
            <children>
                <Label text="Nombre:" />
                <TextField fx:id="txtNombre" promptText="Tu nombre" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Correo Electrónico:" />
                <TextField fx:id="txtCorreo" promptText="ejemplo@coffee.com" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Matrícula (opcional):" />
                <TextField fx:id="txtMatricula" promptText="MAT-2026" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Contraseña (mínimo 6 caracteres):" />
                <PasswordField fx:id="txtPassword" promptText="********" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Confirmar contraseña:" />
                <PasswordField fx:id="txtConfirmar" promptText="********" />
            </children>
        </VBox>

        <Button maxWidth="1.7976931348623157E+308" mnemonicParsing="false" onAction="#handleRegistrar" style="-fx-background-color: #1e5a11; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="Crear Cuenta" />

        <Button maxWidth="1.7976931348623157E+308" mnemonicParsing="false" onAction="#handleVolver" style="-fx-background-color: transparent; -fx-text-fill: #1e5a11; -fx-underline: true;" text="Volver al inicio de sesión" />

        <Label fx:id="lblMensaje" style="-fx-text-fill: red; -fx-font-size: 12px;" wrapText="true" />
    </children>
</VBox>