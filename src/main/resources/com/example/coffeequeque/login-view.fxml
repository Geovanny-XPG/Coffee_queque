<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="350.0" spacing="15.0" style="-fx-padding: 30; -fx-background-color: #fffdf9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coffeequeque.Controller.LoginController">
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e5a11;" text="CoffeeQueque Login" />

        <VBox spacing="5.0">
            <children>
                <Label text="Correo Electrónico:" />
                <TextField fx:id="txtCorreo" promptText="ejemplo@coffee.com" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtPassword" promptText="********" />
            </children>
        </VBox>

        <Button maxWidth="1.7976931348623157E+308" mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #1e5a11; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="Iniciar Sesión" />

        <Label fx:id="lblMensajeError" style="-fx-text-fill: red; -fx-font-size: 12px;" />
    </children>
</VBox>
