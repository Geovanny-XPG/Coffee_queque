<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coffeequeque.Controller.DashboardController">
    <center>
        <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="Catálogo de Productos (Cliente)">
                    <content>
                        <fx:include source="hello-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Módulo de Cocina">
                    <content>
                        <fx:include fx:id="cocina" source="cocina-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Ventanilla de Despacho">
                    <content>
                        <fx:include fx:id="despacho" source="despacho-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Historial de Acciones">
                    <content>
                        <fx:include fx:id="historial" source="historial-view.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>