<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="720.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="txtBuscador" promptText="Buscar producto por nombre..." HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" text="Buscar" />
            </children>
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <content>
                <FlowPane fx:id="flowPaneCatalogo" hgap="15.0" vgap="15.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Café Americano" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $35.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Capuchino" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $45.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Pan de Muerto" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $25.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Cuernito" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $45.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Sandwich" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $30.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Torta de Salchicha" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $40.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Refresco 600ml" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $16.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="278.0" prefWidth="160.0" spacing="5.0" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;">
                            <children>
                                <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                <Label text="Galletas" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Precio: $18.00" />
                                <Button mnemonicParsing="false" text="Agregar" />
                            </children>
                        </VBox>
                    </children>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>

    <!-- Panel del Carrito de Compras agregado a la derecha -->
    <right>
        <VBox prefHeight="470.0" prefWidth="171.0" spacing="10.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #fcfcfc; -fx-padding: 10;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="🛒 Carrito de Compras" />
                <ListView fx:id="listViewCarrito" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                <Label fx:id="lblTotal" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Total: $0.00" />
                <Button fx:id="btnConfirmarPedido" maxWidth="1.7976931348623157E+308" mnemonicParsing="false" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirmar Pedido" />
            </children>
        </VBox>
    </right>
</BorderPane>
